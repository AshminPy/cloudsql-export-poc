# Copy to /etc/pgexport/pgexport.env (mode 0600, owned by the pgexport user).
GCS_BUCKET=example-export-bucket
GCS_PREFIX=exports/
DEST_DIR=/var/backups/pgexport
LOG_FILE=/var/log/pgexport-download.log
RETAIN_DAYS=14

# No GOOGLE_APPLICATION_CREDENTIALS / key file here on purpose. For unattended
# scheduled runs on a real host, provision credentials via Workload Identity
# Federation against your organization's identity provider (short-lived, no key file)
# -- see README "Future on-prem automation". This script also works with a plain
# `gcloud auth login` session for interactive/manual use.
